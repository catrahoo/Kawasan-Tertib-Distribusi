# Copy semua ini ke Streamlit → App → Settings → Secrets, lalu ganti 2 bagian:
# 1) link Google Sheet   2) isi file .json service account (tempel UTUH dari { sampai })

sheet_id = "https://docs.google.com/spreadsheets/d/ID_SHEET/edit"
sheet_name = "DATA OUTLET"
app_password = "ganti_password"

gcp_json = '''
{ TEMPEL ISI FILE .JSON DI SINI }
'''

# Notif WA kalau aplikasi error (CallMeBot). Taruh di bagian paling bawah.
[callmebot]
phone = "+628xxxxxxxxxx"
apikey = "ISI_APIKEY_DARI_CALLMEBOT"

# Supaya tombol "Hapus" foto di COI TANAH AIR tersimpan permanen ke GitHub.
# Token: GitHub → Settings → Developer settings → Fine-grained tokens,
# repo Kawasan-Tertib-Distribusi, izin "Contents: Read and write".
[github]
token = "github_pat_xxx"
repo = "catrahoo/Kawasan-Tertib-Distribusi"
