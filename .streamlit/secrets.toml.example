# Copy isi file ini ke Streamlit Cloud → App → Settings → Secrets
# (JANGAN upload file secrets asli ke GitHub)

sheet_id = "ISI_ID_GOOGLE_SHEET"        # bagian di antara /d/ dan /edit pada link sheet
sheet_name = "DATA OUTLET"
app_password = "ganti_password"         # hapus baris ini kalau tidak mau pakai password

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
